{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief-event-v1",
  "title": "AI Investment Signals - Brief Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","event_id","captured_at","published_at","title","factual_summary","type","theme","subtheme","companies","tickers","sector","sources","direction","horizon","importance","novelty","confidence","execution_risk","pricing_status","story","thesis","frozen"],
  "properties": {
    "schema_version": {"const": "brief-event-v1"},
    "event_id": {"type":"string","pattern":"^EVT-[0-9]{8}-[A-Z0-9]{4,12}$"},
    "captured_at": {"type":"string","format":"date-time"},
    "published_at": {"type":["string","null"],"format":"date-time"},
    "title": {"type":"string","minLength":3},
    "factual_summary": {"type":"string","minLength":10},
    "type": {"enum":["FACT","WEAK_SIGNAL","HYPOTHESIS"]},
    "theme": {"type":"string","minLength":1},
    "subtheme": {"type":"string","minLength":1},
    "companies": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "tickers": {"type":"array","items":{"type":"string","pattern":"^[A-Z0-9.^-]+$"},"uniqueItems":true},
    "sector": {"type":"string","minLength":1},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["url","source_name"],"properties":{"url":{"type":"string","format":"uri"},"source_name":{"type":"string","minLength":1},"source_type":{"type":"string"}}}},
    "direction": {"enum":["positive","negative","neutral"]},
    "horizon": {"enum":["short","medium","long"]},
    "importance": {"type":"integer","minimum":0,"maximum":100},
    "novelty": {"type":"integer","minimum":0,"maximum":100},
    "confidence": {"type":"integer","minimum":0,"maximum":100},
    "execution_risk": {"type":"integer","minimum":0,"maximum":100},
    "pricing_status": {"enum":["not_priced","partially_priced","priced","uncertain"]},
    "story": {"type":"object","additionalProperties":false,"required":["story_id","relation"],"properties":{"story_id":{"type":["string","null"]},"relation":{"enum":["NEW","REPEAT","CONFIRM","ACCELERATE","DETERIORATE","CONTRADICT","RESOLVE"]}}},
    "thesis": {"type":"object","additionalProperties":false,"required":["thesis_ids","statement"],"properties":{"thesis_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"statement":{"type":["string","null"]}}},
    "frozen": {"const": true}
  }
}
